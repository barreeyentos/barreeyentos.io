---
import Layout from "../../../layouts/Layout.astro";
---

<Layout
  title="Day Calculator — barreeyentos"
  description="Day Calculator — pick a date and add days, weeks, months, or years."
>
  <header class="container page-head">
    <span class="eyebrow">// apps / day-calculator</span>
    <h1>Day Calculator</h1>
  </header>

  <div class="prose">
    <p>
      Have trouble figuring out dates on a calendar? Have no clue what 2 months
      from now is? Whether you're trying to figure out when your next dentist
      appointment should be or when you should change the water filter — this
      app is for you.
    </p>
    <p>
      Pick a date to start from, then simply add days, weeks, months, or years
      to that date to get your answer.
    </p>

    <h2>Features</h2>
    <ul class="feature-list">
      <li>Pick a starting date</li>
      <li>Add by Day, Week, Month, or Year</li>
      <li>
        Stack multiple time periods on one date
        — e.g. <code>9/13/20 + 1 day + 3 weeks − 2 months</code>
      </li>
    </ul>

    <h2>Privacy</h2>
    <p>
      The full privacy policy is at
      <a href="/apps/day-calculator/privacy">/apps/day-calculator/privacy</a>.
    </p>
  </div>
</Layout>

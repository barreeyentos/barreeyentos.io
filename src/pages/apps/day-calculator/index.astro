---
import Layout from "../../../layouts/Layout.astro";
---

<Layout
  title="Day Calculator — barreeyentos"
  description="Day Calculator — pick a date and add days, weeks, months, or years."
  pageTitle="Day Calculator"
  centerTitle={true}
>
  <h2>Description</h2>
  <p>
    Have trouble figuring out dates on a calendar? Have no clue what 2 months
    from now is? Whether you're trying to figure out when your next dentist
    appointment should be or when you should change the water filter this app
    is for you.
  </p>
  <p>
    Pick a date to start from and then simply add days, weeks or years to that
    date to get your answer.
  </p>

  <h2>Features</h2>
  <ul>
    <li>Pick a starting date</li>
    <li>Choose to add by Day, Week, Month, or Year</li>
    <li>Add multiple time periods to a date (i.e 9/13/20 + 1day + 3 weeks - 2months)</li>
  </ul>

  <h2>Privacy Policy</h2>
  <p>
    The application's privacy policy can be found
    <a href="/apps/day-calculator/privacy">here</a>.
  </p>
</Layout>

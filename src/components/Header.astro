---
interface Props {
  title?: string;
  centerTitle?: boolean;
  preserveWhitespace?: boolean;
}

const { title, centerTitle = false, preserveWhitespace = false } = Astro.props;
---

<header class="site-header">
  <nav class="site-nav" aria-label="Primary">
    <a href="/" class="brand">barreeyentos</a>
    <div class="nav-links">
      <a href="/about">About</a>
      <a href="/apps/day-calculator">Apps</a>
    </div>
  </nav>
  {
    title && (
      <h1
        class:list={["page-title", { center: centerTitle, tagline: preserveWhitespace }]}
      >
        {title}
      </h1>
    )
  }
</header>
